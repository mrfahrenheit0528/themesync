.venv/
__pycache__/
*.pyc
# Data: everything is tracked (so work can continue off the school server)
# except
#  - the CGL dataset (2.8 GB arrow + its 257 MB YOLO export; re-create with
#    src/data_preprocessing/ingest_cgl.py / prepare_yolo_dataset.py),
#  - the 18 sample IDs with real people's photos,
#  - training copies whose images are symlinks to server paths (rebuild with
#    src/data_preprocessing/prepare_master_layout_dataset.py).
data/processed/cgl_tensor_dataset/
data/processed/yolo_dataset/
data/processed/yolo_master_v4/
data/processed/yolo_master_v5/
data/raw/ID_layouts/
# Regenerable run output (rewritten by every pipeline run, dashboard session
# and Phase 3 battery); a snapshot is in the 2026-10-07 commit.
data/rendered/
data/processed/Candidate_*.json
data/processed/layout_state_v1*.json
*.cache
*.arrow
repomix-output.xml
.ipynb_checkpoints/

# public base weights (Ultralytics downloads them on demand) and unpromoted candidates
yolo26n.pt
yolov8s.pt
*_candidate.pt

# LaTeX build files from building the manuscript in place (VS Code LaTeX
# Workshop); the sources and figures are what get committed.
manuscript/**/*.aux
manuscript/**/*.acn
manuscript/**/*.bbl
manuscript/**/*.bcf
manuscript/**/*.blg
manuscript/**/*.fdb_latexmk
manuscript/**/*.fls
manuscript/**/*.glo
manuscript/**/*.ist
manuscript/**/*.log
manuscript/**/*.run.xml
manuscript/**/*.synctex.gz
manuscript/**/*.synctex(busy)
